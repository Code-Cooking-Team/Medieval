{
  "plugins": ["import", "typescript"],
  "rules": {
    "import/no-cycle": "warn",
    "no-unused-vars": "off",
    "typescript/consistent-type-imports": [
      "error",
      {
        "prefer": "type-imports",
        "fixStyle": "inline-type-imports",
        "disallowTypeAnnotations": true
      }
    ]
  },
  "tsconfig": "./tsconfig.json"
}
